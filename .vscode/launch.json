{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Attach OpenFin",
			"type": "chrome",
			"request": "attach",
			"port": 9090,
			"address": "localhost",
			"webRoot": "${workspaceRoot}/packages/desktopjs-openfin/dist",
			"sourceMaps": true
		},
		{
            "type": "node",
            "request": "launch",
            "name": "Debug Vitest",
            "autoAttachChildProcesses": true,
            "skipFiles": ["<node_internals>/**"],
            "program": "${workspaceRoot}/node_modules/vitest/vitest.mjs",
            "args": ["run"],
            "smartStep": true
        }
	]
}
